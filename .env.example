# ---------------------------------------------------------------------------
# BIS Mitra — environment variables
#
# The application runs fully without any of these. Set GEMINI_API_KEY to enable
# model-written explanations; without it BIS Mitra uses its deterministic,
# grounded fallback composer, which still answers from the retrieved records.
# ---------------------------------------------------------------------------

# Google AI Studio key. Leave empty for the deterministic fallback.
GEMINI_API_KEY=

# Model used for explanations. Any Gemini model name works.
GEMINI_MODEL=gemini-2.0-flash

# Alternate key name also honoured (Google AI SDK convention).
GOOGLE_API_KEY=

# Milliseconds before the model call is abandoned and the fallback answers.
LLM_TIMEOUT_MS=12000
